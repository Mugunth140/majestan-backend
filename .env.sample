NODE_ENV=development
APP_NAME=Majestan API
PORT=5000
API_PREFIX=api/v1
DOCS_PATH=docs
DOCS_TITLE=Majestan API
DOCS_DESCRIPTION=API documentation for Majestan backend services.
DOCS_VERSION=1.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
TRUST_PROXY=false
ENABLE_DOCS=true

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=Secure@12345
DB_NAME=maje_majestan
DB_POOL_SIZE=6
DB_SSL=false
 
JWT_ACCESS_SECRET=replace-with-a-very-long-random-jwt-secret-at-least-32-chars
JWT_ACCESS_TTL=7d
BCRYPT_SALT_ROUNDS=12
AUTH_ALLOW_LEGACY_PLAIN_PASSWORD=false

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://pub-your_subdomain.r2.dev

# File uploads: 'r2' (default — production/staging/VPS) or 'local' (local dev:
# files land in LOCAL_UPLOAD_DIR, served by this API, no R2 needed).
STORAGE_DRIVER=r2
LOCAL_UPLOAD_DIR=./uploads
LOCAL_UPLOAD_BASE_URL=http://localhost:5000
IMGPROXY_URL=http://imgproxy:8080

GOOGLE_MAPS_API_KEY=YOUR_VERY_OWN_KEY

PAY4SMS_API_URL=http://pay4sms.in/sendsms/
PAY4SMS_TOKEN=
PAY4SMS_SENDER_ID=PRSMRK
PAY4SMS_REGISTER_TEMPLATE_ID=1777179023885095379
PAY4SMS_LOGIN_TEMPLATE_ID=1777179016683380342